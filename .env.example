# SecOps Copilot 环境变量示例
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 排除，切勿提交真实密钥）
# 降级链：OpenAI（兼容的都可以） → DeepSeek → Ollama(本地模型，默认qwen3:8b) → Refuse（安全拒答）
# 可根据自己需求修改

# ---------- 主链路 LLM API  ----------

# 档位1 = OpenAI 档位，第一级，以ByteDance Ark为例
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPENAI_MODEL=ark-code-latest

# 档位2 = DeepSeek（第二降级）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 档位3 = 本地降级（Ollama），以qwen3:8b为例，本地模型无需key
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Embedding 模型 以 Ollama 本地模型 nomic-embed-text 为例
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama # 本地模型，本地不校验，这只是占位，云模型请填入真实key

# RAGAs 评测裁判模型，建议与主模型不要相同，避免自洽，以 DeepSeek 为例
RAGAS_JUDGE_MODEL=deepseek-v4-flash
RAGAS_JUDGE_KEY=
RAGAS_JUDGE_URL=https://api.deepseek.com

# 可观测（Langfuse配置）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 是否把事件上报到 Langfuse（false 可纯本地跑，jsonl兜底）
LANGFUSE_SINK_ENABLED=false

# ---------- 运行开关 ----------
# dry-run 模式（模拟工具执行，不触达真实安全系统）
DRY_RUN=false

# ---------- 存储 ----------
# Redis：短期记忆（24h 跨进程同步，多用户隔离）
REDIS_URI=redis://localhost:6379/0
# PostgreSQL：长期记忆（默认为本地 Docker postgres 实例）
POSTGRES_URI=postgresql://postgres:mysecretpassword@localhost:5432/memory_db

# ---------- RAG / 工具 ----------
# MCP 工具检索返回条数
MCP_TOP_K=3
